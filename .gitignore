# ==========================================
# .gitignore para Tesina: AERMOD + Python
# ==========================================

# 1. Archivos de sistema macOS y Nube
.DS_Store
.AppleDouble
.LSOverride
.tmp.driveupload/

# 2. Python y Jupyter
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.env
venv/
env/

# 3. Directorios de Datos (ignorar archivos, conservar estructura con .gitkeep)
02-data/**
!02-data/**/
!02-data/**/.gitkeep
!02-data/README.md
03-analysis/tutorial_wisconsin/
03-analysis/run_aermet_*/
01-literature-tesina/*.pdf

# 4. Formatos de datos espaciales y tabulares pesados
*.csv
*.xlsx
*.parquet
*.shp
*.shx
*.dbf
*.tif

# 5. Binarios, compiladores y código fuente de Fortran
*.x
*.o
*.exe
*.dll
*.zip
*.mod
03-analysis/aermod_bin/src_*/

# 6. Outputs gigantes de AERMAP / AERMET / AERMOD
*.out
*.msg
*.plt
*.pst
*.log
*.rou
*.sou
*.sfc
*.pfl
*.sum
*.ext
*.qa
*.rpt
*.geojson
*.err

# 7. Archivos temporales en vivo de corridas POSTFILE 95d
03-analysis/run_aermod_postfile_95d/aermod.inp
03-analysis/run_aermod_postfile_95d/log_corrida_*.txt

# 8. Excepción: conservar completo el Toy Case de onboarding (~256 KB)
!00-onboarding-aermod/toy_case/*
